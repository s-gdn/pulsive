per_frame_2=zoom=1.004+0.004*mid_att;wave_x=0.5+0.12*sin(time*0.3);wave_y=0.5+0.1*cos(time*0.23);
per_pixel_1=dx=0.009*sin(y*12+time*0.4)+0.004*cos(rad*9-time*0.3);dy=0.009*cos(x*12-time*0.35)+0.004*sin(rad*9+time*0.23);
